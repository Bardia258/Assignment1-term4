@model IEnumerable<MunicipalElections.Web.ViewModels.CandidateViewModel>

@{
    ViewData["Title"] = "My Voting Guide";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>My Voting Guide</h1>
    @if (Model.Any())
    {
        <a asp-action="Print" class="btn btn-success">Print My Guide</a>
    }
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        You haven't selected any candidates yet. Browse the <a asp-controller="Candidates" asp-action="Index">Candidate Directory</a> to add them to your guide.
    </div>
}
else
{
    <div class="row">
        @foreach (var candidate in Model)
        {
            <div class="col-md-6 mb-4">
                <div class="card shadow-sm border-success">
                    <div class="card-body d-flex justify-content-between align-items-center">
                        <div>
                            <h5 class="card-title mb-1">@candidate.Name</h5>
                            <h6 class="card-subtitle text-success">@candidate.PositionTitle</h6>
                            <div class="text-muted mt-2">
                                <partial name="_MunicipalityBadge" model="@(new MunicipalElections.Web.ViewModels.MunicipalityViewModel { Name = candidate.MunicipalityName, LogoUrl = candidate.MunicipalityLogoUrl })" />
                            </div>
                        </div>
                        <div>
                            <a asp-action="Remove" asp-route-id="@candidate.Id" class="btn btn-outline-danger btn-sm">Remove</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
