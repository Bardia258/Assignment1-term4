@model MunicipalElections.Web.ViewModels.CandidateViewModel

@{
    ViewData["Title"] = Model.Name;
}

<div class="row mt-4">
    <!-- Left Column: Photo & Quick Actions -->
    <div class="col-md-4 mb-4">
        <div class="card shadow-sm border-primary">
            @if (!string.IsNullOrEmpty(Model.PhotoUrl))
            {
                <img src="@Model.PhotoUrl" class="card-img-top" alt="@Model.Name" style="object-fit: cover;">
            }
            else
            {
                <div class="bg-secondary text-white d-flex justify-content-center align-items-center" style="height: 300px;">
                    <h5>No Photo Available</h5>
                </div>
            }
            <div class="card-body text-center">
                <a asp-controller="VotingGuide" asp-action="Add" asp-route-id="@Model.Id" class="btn btn-success w-100 mb-2">+ Add to My Voting Guide</a>
                <a asp-action="Index" class="btn btn-outline-secondary w-100">Back to Directory</a>
            </div>
        </div>
    </div>

    <!-- Right Column: Profile Details -->
    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-body">
                <h1 class="card-title fw-bold text-primary">@Model.Name</h1>
                <h4 class="card-subtitle mb-3 text-muted">@Model.PositionTitle - @Model.MunicipalityName</h4>
                
                <hr />
                
                <h5 class="mt-4">Biography / Profile</h5>
                <p class="lead" style="white-space: pre-wrap;">@Model.Profile</p>
                
                <hr />
                
                <h5 class="mt-4">Contact Information</h5>
                <ul class="list-unstyled">
                    @if (!string.IsNullOrEmpty(Model.Website))
                    {
                        <li class="mb-2">
                            <strong>Website:</strong> 
                            <a href="@Model.Website" target="_blank">@Model.Website</a>
                        </li>
                    }
                    else
                    {
                        <li class="mb-2 text-muted"><strong>Website:</strong> Not provided</li>
                    }

                    @if (!string.IsNullOrEmpty(Model.Email))
                    {
                        <li class="mb-2">
                            <strong>Email:</strong> 
                            <a href="mailto:@Model.Email">@Model.Email</a>
                        </li>
                    }
                    else
                    {
                        <li class="mb-2 text-muted"><strong>Email:</strong> Not provided</li>
                    }
                </ul>
            </div>
        </div>
    </div>
</div>
