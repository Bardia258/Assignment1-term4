@model IEnumerable<MunicipalElections.Web.ViewModels.CandidateViewModel>

@{
    ViewData["Title"] = "Candidate Directory";
}

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4">
    <h1 class="mb-0">Candidate Directory</h1>
    <div class="directory-municipality-filter">
        <label for="directory-municipality" class="form-label">Municipality</label>
        <select id="directory-municipality" name="municipalityId" class="form-select" form="candidate-filter-form"
                data-municipality-filter asp-items="@(new SelectList(ViewBag.Municipalities, "Id", "Name", ViewBag.CurrentMunicipality))">
            <option value="">All Municipalities</option>
        </select>
    </div>
</div>

<!-- Search and Filter Form -->
<div class="card bg-body-tertiary mb-4 shadow-sm">
    <div class="card-body">
        <form id="candidate-filter-form" asp-action="Index" method="get" class="row g-3">
            <div class="col-md-6">
                <label for="candidate-name" class="form-label">Search by Name</label>
                <input id="candidate-name" type="text" name="searchString" value="@ViewBag.CurrentSearch" class="form-control" placeholder="Enter candidate name..." />
            </div>
            <div class="col-md-4">
                <label for="candidate-position" class="form-label">Position</label>
                <select id="candidate-position" name="positionId" class="form-select" asp-items="@(new SelectList(ViewBag.Positions, "Id", "Name", ViewBag.CurrentPosition))">
                    <option value="">All Positions</option>
                </select>
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <button type="submit" class="btn btn-primary w-100">Search</button>
            </div>
        </form>
    </div>
</div>

<!-- Results -->
<div class="row">
    @if (!Model.Any())
    {
        <div class="col-12 text-center py-5">
            <h4 class="text-muted">No candidates found matching your criteria.</h4>
        </div>
    }
    else
    {
        @foreach (var candidate in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100 shadow-sm border-primary">
                    @if (!string.IsNullOrEmpty(candidate.PhotoUrl))
                    {
                        <img src="@candidate.PhotoUrl" class="card-img-top" alt="@candidate.Name" style="height: 250px; object-fit: cover;">
                    }
                    else
                    {
                        <div class="bg-secondary text-white d-flex justify-content-center align-items-center" style="height: 250px;">
                            <span>No Photo</span>
                        </div>
                    }
                    <div class="card-body">
                        <h5 class="card-title fw-bold">@candidate.Name</h5>
                        <h6 class="card-subtitle mb-2 text-primary">@candidate.PositionTitle</h6>
                        <div class="card-text text-muted mb-2">
                            <partial name="_MunicipalityBadge" model="@(new MunicipalElections.Web.ViewModels.MunicipalityViewModel { Name = candidate.MunicipalityName, LogoUrl = candidate.MunicipalityLogoUrl })" />
                        </div>
                        <p class="card-text text-truncate">@candidate.Profile</p>
                    </div>
                    <div class="card-footer bg-body border-top-7">
                        <a asp-action="Details" asp-controller="Candidates" asp-route-id="@candidate.Id" class="btn btn-outline-primary w-100">View Profile</a>
                    </div>
                    <div class="card-footer bg-body border-top-7">
                        <a asp-action="Add" asp-controller="VotingGuide" asp-route-id="@candidate.Id" class="btn btn-success w-50">+ Add to Guide</a>
                    </div>
                </div>
            </div>
        }
    }
</div>
