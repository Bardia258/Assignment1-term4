@model MunicipalElections.Web.ViewModels.MunicipalityViewModel

@{ ViewData["Title"] = Model.Name; }

<div class="bg-body-tertiary p-4 rounded shadow-sm mb-4 municipality-detail-header">
    <h1 class="display-5 fw-bold text-primary"><partial name="_MunicipalityBadge" model="Model" /></h1>
    <h5 class="text-muted">@Model.Province</h5>
    <p class="lead mt-3">@Model.Description</p>
    <p class="text-danger fw-bold mb-0">Election Date: @Model.ElectionDate.ToString("MMMM dd, yyyy")</p>
    <div class="mt-4 municipality-position-summary">
        <partial name="_PositionSeats" model="Model.Positions" />
    </div>
</div>

<h3 class="mb-4">Candidates for @Model.Name</h3>

@{
    var candidates = ViewBag.Candidates as IEnumerable<MunicipalElections.Web.ViewModels.CandidateViewModel>;
}

@if (candidates != null && candidates.Any())
{
    <div class="row">
        @foreach (var candidate in candidates)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100 shadow-sm border-primary">
                    @if (!string.IsNullOrEmpty(candidate.PhotoUrl))
                    {
                        <img src="@candidate.PhotoUrl" class="card-img-top" alt="@candidate.Name" style="height: 250px; object-fit: cover;">
                    }
                    else
                    {
                        <div class="bg-secondary text-white d-flex justify-content-center align-items-center" style="height: 250px;">
                            <span>No Photo</span>
                        </div>
                    }
                    <div class="card-body">
                        <h5 class="card-title fw-bold">@candidate.Name</h5>
                        <h6 class="card-subtitle mb-2 text-primary">@candidate.PositionTitle</h6>
                        <div class="text-muted mb-2">
                            <partial name="_MunicipalityBadge" model="Model" />
                        </div>
                        <p class="card-text text-truncate">@candidate.Profile</p>
                    </div>
                    <div class="card-footer bg-body border-top-0 d-flex justify-content-between">
                        <a asp-controller="Candidates" asp-action="Details" asp-route-id="@candidate.Id" class="btn btn-outline-primary w-50 me-2">View Profile</a>
                        <a asp-controller="VotingGuide" asp-action="Add" asp-route-id="@candidate.Id" class="btn btn-success w-50">+ Add to Guide</a>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="alert alert-info">No candidates registered for this municipality yet.</div>
}
