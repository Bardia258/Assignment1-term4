<hr />

<h3>Candidates</h3>
@{
    var candidates = ViewBag.Candidates as IEnumerable<MunicipalElections.Web.ViewModels.CandidateViewModel>;
}

@if (candidates != null && candidates.Any())
{
    <div class="row mt-3">
        @foreach (var candidate in candidates)
        {
            <div class="col-md-4 mb-3">
                <div class="card border-primary h-100">
                    <div class="card-body">
                        <h5 class="card-title">@candidate.Name</h5>
                        <h6 class="card-subtitle mb-2 text-muted">@candidate.PositionTitle</h6>
                        <p class="card-text">@candidate.Bio</p>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <p class="text-muted">No candidates registered for this municipality yet.</p>
}