@model PositionInput
@{ ViewData["Title"] = "Edit position"; }
<h1>Edit position</h1>
<form asp-area="Admin" asp-controller="Positions" asp-action="Edit" asp-route-id="@(ViewContext.RouteData.Values["id"])" method="post" enctype="multipart/form-data" class="card card-body admin-form">
    <partial name="_Form" model="Model" />
    <div class="d-flex gap-2"><button type="submit" class="btn btn-primary">Save</button><a asp-area="Admin" asp-controller="Positions" asp-action="Index" class="btn btn-outline-secondary">Cancel</a></div>
</form>
@section Scripts {
    <partial name="/Views/Shared/_ValidationScriptsPartial.cshtml" />

}

