@model Candidate
@{ ViewData["Title"] = "Details"; }
<h1>Details candidate</h1>
<partial name="_SeedNotice" model="@(Model.SeedKey ?? string.Empty)" />
<div asp-validation-summary="All" class="text-danger" role="alert"></div>
<div class="card card-body mb-3"><partial name="_Details" model="Model" /></div>
<a asp-area="Admin" asp-controller="Candidates" asp-action="Edit" asp-route-id="@Model.CandidateId" class="btn btn-primary">Edit</a>
<a asp-area="Admin" asp-controller="Candidates" asp-action="Index" class="btn btn-outline-secondary">Back to list</a>

