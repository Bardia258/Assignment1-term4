@model CandidateInput
@{ ViewData["Title"] = "Create candidate"; }
<h1>Create candidate</h1>
<form asp-area="Admin" asp-controller="Candidates" asp-action="Create" method="post" enctype="multipart/form-data" class="card card-body admin-form">
    <partial name="_Form" model="Model" />
    <div class="d-flex gap-2"><button type="submit" class="btn btn-primary">Save</button><a asp-area="Admin" asp-controller="Candidates" asp-action="Index" class="btn btn-outline-secondary">Cancel</a></div>
</form>
@section Scripts {
    <partial name="/Views/Shared/_ValidationScriptsPartial.cshtml" />
    <script src="~/js/admin-candidates.js" asp-append-version="true"></script>
}

