@model CandidateInput
<div asp-validation-summary="All" class="text-danger" role="alert"></div>
<input asp-for="Revision" type="hidden" />
<div class="mb-3"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name"></span></div>
<div class="row">
    <div class="col-sm-6 mb-3"><label asp-for="MunicipalityId" class="form-label"></label><select asp-for="MunicipalityId" asp-items="Model.Municipalities" class="form-select" data-positions-url="@Url.Action("PositionOptions", "Candidates", new { area = "Admin" })"><option value="">Choose a municipality</option></select><span asp-validation-for="MunicipalityId"></span></div>
    <div class="col-sm-6 mb-3"><label asp-for="PositionId" class="form-label"></label><select asp-for="PositionId" asp-items="Model.Positions" class="form-select"><option value="">Choose a position</option></select><span asp-validation-for="PositionId"></span><div id="position-status" class="form-text" role="status"></div></div>
</div>
<div class="mb-3"><label asp-for="Profile" class="form-label"></label><textarea asp-for="Profile" class="form-control" rows="7"></textarea><span asp-validation-for="Profile"></span></div>
<div class="mb-3"><label asp-for="Website" class="form-label"></label><input asp-for="Website" type="url" class="form-control" placeholder="https://example.com" /><span asp-validation-for="Website"></span></div>
<div class="mb-3"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" /><span asp-validation-for="Email"></span></div>
@if (Images.Url(Model.CurrentImage, "candidates") is string imageUrl) { <img src="@Url.Content("~" + imageUrl)" class="admin-preview mb-3" alt="Current candidate photograph" /> }
<div class="mb-3"><label asp-for="Image" class="form-label"></label><input asp-for="Image" type="file" class="form-control" accept="image/png,image/jpeg,image/webp" /><div class="form-text">PNG, JPEG, or WebP. Maximum 2 MB; optional. Leave blank to keep the current photo.</div><span asp-validation-for="Image"></span></div>
