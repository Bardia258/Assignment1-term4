@model Candidate
@if (Images.Url(Model.PhotoFileName, "candidates") is string imageUrl) { <img src="@Url.Content("~" + imageUrl)" class="admin-preview mb-3" alt="Photograph of @Model.Name" /> }
<dl class="row"><dt class="col-sm-3">Name</dt><dd class="col-sm-9">@Model.Name</dd><dt class="col-sm-3">Municipality</dt><dd class="col-sm-9">@Model.Municipality.Name</dd><dt class="col-sm-3">Position</dt><dd class="col-sm-9">@Model.Position.Name</dd><dt class="col-sm-3">Biography</dt><dd class="col-sm-9 biography">@Model.Profile</dd><dt class="col-sm-3">Website</dt><dd class="col-sm-9">@Model.Website</dd><dt class="col-sm-3">Email</dt><dd class="col-sm-9">@Model.Email</dd><dt class="col-sm-3">Created (UTC)</dt><dd class="col-sm-9">@Model.DateCreated.ToString("yyyy-MM-dd HH:mm")</dd></dl>
