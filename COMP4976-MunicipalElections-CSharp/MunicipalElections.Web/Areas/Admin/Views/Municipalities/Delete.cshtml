@model Municipality
@{ ViewData["Title"] = "Delete"; }
<h1>Delete municipality</h1>
<partial name="_SeedNotice" model="@(Model.SeedKey ?? string.Empty)" />
<div asp-validation-summary="All" class="text-danger" role="alert"></div>
<div class="card card-body mb-3"><partial name="_Details" model="Model" /></div>
<p class="fw-bold">Are you sure you want to delete this record?</p>

<form asp-area="Admin" asp-controller="Municipalities" asp-action="Delete" asp-route-id="@(ViewContext.RouteData.Values["id"])" method="post" class="d-flex gap-2">
    <input type="hidden" name="revision" value="@Model.Revision" />
    <button type="submit" class="btn btn-danger">Confirm delete</button>
    <a asp-area="Admin" asp-controller="Municipalities" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</form>

